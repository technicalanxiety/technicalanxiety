---
// Topic landing page (/azure/, /governance/, ...): intro, topics covered, and
// every published post carrying the topic's tag. Each topic page in src/pages
// is a thin wrapper that passes its copy here.
import { getPublishedPosts } from '../utils/posts';
import TopicShell from './TopicShell.astro';
import PostGrid from '../components/PostGrid.astro';

export interface Props {
  /** Page <title> without the site name (BaseLayout appends it) */
  title: string;
  /** Post tag to list; also the page heading (e.g. "Log Analytics") */
  tag: string;
  icon: string;
  subtitle: string;
  description: string;
  intro: string;
  topics: string[];
}

const { title, tag, icon, subtitle, description, intro, topics } = Astro.props;

const posts = await getPublishedPosts();
const topicPosts = posts
  .filter((post) => post.data.tags?.includes(tag))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<TopicShell title={title} description={description} heading={tag} subtitle={subtitle} icon={icon}>
  <div class="topic-intro">
    <h3>What You'll Find Here</h3>
    <p>
      {intro}
    </p>
    
    <div class="topics-covered">
      <h4>Topics covered:</h4>
      <ul>
        {topics.map((topic) => <li>{topic}</li>)}
      </ul>
    </div>
  </div>

  <div class="posts-section">
    <h3>Latest {tag} Posts</h3>
    <PostGrid posts={topicPosts} />
    
    {topicPosts.length === 0 && (
      <p class="no-posts">No {tag} posts found. Check back soon!</p>
    )}
  </div>
</TopicShell>

<style>
  .topic-intro {
    background: var(--bg-secondary);
    padding: 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    margin-bottom: 3rem;
  }

  .topic-intro h3 {
    font-size: 1.5rem;
    color: var(--text-heading);
    margin-bottom: 1rem;
  }

  .topic-intro p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .topics-covered h4 {
    color: var(--text-heading);
    margin-bottom: 0.75rem;
    font-size: 1.125rem;
  }

  .topics-covered ul {
    list-style: none;
    padding: 0;
  }

  .topics-covered li {
    color: var(--text-secondary);
    padding: 0.25rem 0;
    position: relative;
    padding-left: 1.5rem;
  }

  .topics-covered li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-color);
    font-weight: bold;
  }

  .no-posts {
    text-align: center;
    color: var(--text-secondary);
    font-style: italic;
    padding: 2rem;
  }
</style>
