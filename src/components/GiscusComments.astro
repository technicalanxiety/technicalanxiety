---
// Giscus (GitHub Discussions) comments.
// The client script is created at runtime so it can start with the page's
// current theme; theme changes are pushed to the iframe with postMessage
// instead of reloading it. Custom themes live in public/giscus/.
import { siteConfig } from '../config';

const { giscus } = siteConfig;
const isConfigured = Boolean(giscus?.repo && giscus?.repoId && giscus?.categoryId);
---

<section class="giscus-container" aria-label="Comments">
  {isConfigured ? (
    <div
      id="giscus-container"
      data-repo={giscus.repo}
      data-repo-id={giscus.repoId}
      data-category={giscus.category}
      data-category-id={giscus.categoryId}
    ></div>
  ) : (
    <div class="giscus-placeholder">
      <p>Comments are temporarily unavailable. Please check back later.</p>
      <p><small>If you're the site owner, please configure Giscus in your site settings.</small></p>
    </div>
  )}
</section>

<script>
  const GISCUS_ORIGIN = 'https://giscus.app';

  // Custom themes are passed as an absolute URL so Giscus (running on giscus.app)
  // can fetch them from production or staging. Giscus won't load a theme from a
  // plain-http origin (local dev/preview), which leaves the widget unstyled, so
  // fall back to the stock light/dark themes there.
  function themeUrl(): string {
    const theme = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    if (window.location.protocol !== 'https:') return theme;
    return `${window.location.origin}/giscus/${theme}.css`;
  }

  function loadGiscus(container: HTMLElement) {
    const { repo, repoId, category, categoryId } = container.dataset;
    const script = document.createElement('script');
    script.src = `${GISCUS_ORIGIN}/client.js`;
    script.async = true;
    script.crossOrigin = 'anonymous';

    const attrs: Record<string, string> = {
      'data-repo': repo ?? '',
      'data-repo-id': repoId ?? '',
      'data-category': category ?? '',
      'data-category-id': categoryId ?? '',
      'data-mapping': 'pathname',
      'data-strict': '0',
      'data-reactions-enabled': '1',
      'data-emit-metadata': '0',
      'data-input-position': 'bottom',
      'data-theme': themeUrl(),
      'data-lang': 'en',
      'data-loading': 'lazy',
    };
    Object.entries(attrs).forEach(([name, value]) => script.setAttribute(name, value));

    container.appendChild(script);
  }

  // Tell an already-loaded Giscus iframe to switch themes in place
  function syncGiscusTheme() {
    const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    iframe?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: themeUrl() } } },
      GISCUS_ORIGIN
    );
  }

  const container = document.getElementById('giscus-container');
  if (container) {
    loadGiscus(container);

    new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }
</script>

<style>
  .giscus-container {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .giscus-placeholder {
    text-align: center;
    padding: 2rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .giscus-placeholder p {
    margin: 0.5rem 0;
  }

  .giscus-placeholder small {
    opacity: 0.7;
  }
</style>
