---
// Vertical list of post previews (title, date, description, tags).
// Used by the paginated archive (/page/N/) and tag pages (/tags/X/).
import type { CollectionEntry } from 'astro:content';

export interface Props {
  posts: CollectionEntry<'posts'>[];
  /** Tag to highlight in each post's tag list (tag pages) */
  currentTag?: string;
}

const { posts, currentTag } = Astro.props;
---

<div class="posts-list">
  {posts.map((post) => (
    <article class="post-preview">
      <header class="post-header">
        <h2 class="post-title">
          <a href={`/${post.id}/`}>{post.data.title}</a>
        </h2>
        <time class="post-date" datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
      </header>

      {post.data.description && (
        <p class="post-description">{post.data.description}</p>
      )}

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class:list={['tag', { 'tag-current': tag === currentTag }]}>
              {tag}
            </a>
          ))}
        </div>
      )}
    </article>
  ))}
</div>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .post-preview {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
    transition: box-shadow 0.2s ease;
  }

  .post-preview:hover {
    box-shadow: var(--shadow-lg);
  }

  .post-header {
    margin-bottom: 1rem;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .post-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .post-title a:hover {
    color: var(--accent-color);
  }

  .post-date {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .post-description {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: var(--bg-tertiary);
    color: var(--text-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
  }

  .tag:hover {
    background: var(--accent-color);
    color: white;
    border-color: var(--accent-color);
  }

  .tag-current {
    background: var(--accent-color);
    color: white;
    border-color: var(--accent-color);
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 1.25rem;
    }
  }
</style>
