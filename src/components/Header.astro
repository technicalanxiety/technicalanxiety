---
// Header component - navigation and search
import Icon from './Icon.astro';
---

<header class="header">
  <div class="container">
    <div class="row">
      <div class="col col-12">
        <div class="header-box">
          <div class="logo-title">
            <a href="/" class="logo-text">TECHNICAL_ANXIETY</a>
          </div>

          <nav class="nav-menu" id="site-nav" aria-label="Main">
            <button type="button" class="menu-close" aria-label="Close navigation menu">
              <Icon name="close-outline" />
            </button>
            <ul class="menu-list">
              <li class="menu-item"><a href="/" class="menu-link">Home</a></li>
              <li class="menu-item"><a href="/archive/" class="menu-link">Archive</a></li>
              <li class="menu-item"><a href="/architecture/" class="menu-link menu-link--accent">Architecture</a></li>
              <li class="menu-item"><a href="/series/" class="menu-link">Series</a></li>
              <li class="menu-item"><a href="/resume/" class="menu-link">Resume</a></li>
              <li class="menu-item"><a href="/loom/" class="menu-link">Loom</a></li>
              <li class="menu-item"><a href="/about/" class="menu-link">About</a></li>
            </ul>
          </nav>
          
          <div class="nav-buttons">
            <button type="button" class="menu-button d-hide" aria-label="Open navigation menu" aria-controls="site-nav" aria-expanded="false">
              <Icon name="menu-outline" />
            </button>
            <button type="button" class="search-button" aria-label="Open search" aria-controls="site-search" aria-expanded="false">
              <Icon name="search-outline" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="search" id="site-search" role="dialog" aria-modal="true" aria-label="Search posts">
    <div class="search-box">
      <button type="button" class="search-close-button" aria-label="Close search">
        <Icon name="close-outline" />
      </button>
      <div class="search-hint">Press <kbd>Ctrl</kbd> + <kbd>K</kbd> to search (or <kbd>⌘</kbd> + <kbd>K</kbd> on Mac)</div>
      <label for="search-input" class="screen-reader-text">Search</label>
      <input type="text" id="search-input" class="search-text" autocomplete="off" placeholder="Search posts by title, content, or tags...">
      <ol id="search-results-list" class="search-results-list"></ol>
    </div>
  </div>
</header>

<script>
  import Fuse from 'fuse.js';

  interface SearchItem {
    id: string;
    title: string;
    description: string;
    content: string;
    tags: string[];
    date: string;
    url: string;
  }

  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.querySelector<HTMLButtonElement>('.header .menu-button');
    const menuClose = document.querySelector<HTMLButtonElement>('.header .menu-close');
    const navMenu = document.querySelector('.nav-menu');

    function openMenu() {
      navMenu?.classList.add('is-open');
      menuButton?.setAttribute('aria-expanded', 'true');
      menuClose?.focus();
    }

    // Only return focus when the menu was actually open, so Escape on a
    // page with the menu closed doesn't yank focus to the hamburger.
    function closeMenu() {
      if (!navMenu?.classList.contains('is-open')) return;
      navMenu.classList.remove('is-open');
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.focus();
    }

    menuButton?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);

    // Search functionality. Scoped to .header: SearchBox.astro also has a
    // .search-button (its submit button) on some pages.
    const searchButton = document.querySelector<HTMLButtonElement>('.header .search-button');
    const searchClose = document.querySelector('.header .search-close-button');
    const search = document.querySelector('.header .search');
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('search-results-list');
    
    let fuse: Fuse<SearchItem> | null = null;
    let searchIndex: SearchItem[] = [];
    
    // Load search index
    async function loadSearchIndex() {
      try {
        const response = await fetch('/search.json');
        searchIndex = await response.json();
        
        fuse = new Fuse(searchIndex, {
          keys: [
            { name: 'title', weight: 0.4 },
            { name: 'description', weight: 0.3 },
            { name: 'content', weight: 0.2 },
            { name: 'tags', weight: 0.1 }
          ],
          threshold: 0.3,
          includeScore: true,
          minMatchCharLength: 2,
        });
      } catch (error) {
        console.error('Failed to load search index:', error);
      }
    }
    
    // Perform search
    function performSearch(query: string) {
      if (!fuse || !resultsContainer) return;
      
      if (query.length < 2) {
        resultsContainer.innerHTML = '';
        return;
      }
      
      const results = fuse.search(query);
      displayResults(results);
    }
    
    // Display search results
    function displayResults(results: import('fuse.js').FuseResult<SearchItem>[]) {
      if (!resultsContainer) return;
      
      resultsContainer.innerHTML = '';
      
      if (results.length === 0) {
        resultsContainer.innerHTML = '<li class="search-no-results">No posts found. Try different keywords.</li>';
        return;
      }
      
      results.slice(0, 10).forEach(result => {
        const item = result.item;
        const li = document.createElement('li');
        li.className = 'search-item';
        
        const date = new Date(item.date).toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric'
        });
        
        li.innerHTML = `
          <a href="${item.url}" class="search-result-link">
            <div class="search-result-title">${item.title}</div>
            <div class="search-result-meta">
              <span class="search-result-date">${date}</span>
              ${item.tags.length > 0 ? `<span class="search-result-tags">${item.tags.slice(0, 3).join(', ')}</span>` : ''}
            </div>
            ${item.description ? `<div class="search-result-description">${item.description}</div>` : ''}
          </a>
        `;
        
        resultsContainer.appendChild(li);
      });
    }
    
    // Search input handler
    searchInput?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.trim();
      performSearch(query);
    });
    
    // Search toggle. Remember what had focus so closing returns there
    // (the search button, or wherever Ctrl+K was pressed).
    let searchReturnFocus: HTMLElement | null = null;

    function openSearch() {
      if (search?.classList.contains('is-visible')) {
        searchInput?.focus();
        return;
      }
      searchReturnFocus = document.activeElement as HTMLElement | null;
      search?.classList.add('is-visible');
      searchButton?.setAttribute('aria-expanded', 'true');
      searchInput?.focus();
    }

    function closeSearch() {
      if (!search?.classList.contains('is-visible')) return;
      search.classList.remove('is-visible');
      searchButton?.setAttribute('aria-expanded', 'false');
      if (searchInput) searchInput.value = '';
      if (resultsContainer) resultsContainer.innerHTML = '';
      searchReturnFocus?.focus();
    }

    searchButton?.addEventListener('click', openSearch);
    searchClose?.addEventListener('click', closeSearch);

    // Keyboard shortcut for search
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        openSearch();
      }

      if (e.key === 'Escape') {
        closeSearch();
        closeMenu();
      }
    });
    
    // Load search index on page load
    loadSearchIndex();
  });
</script>