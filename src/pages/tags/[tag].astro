---
import { getPublishedPosts } from '../../utils/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Sidebar from '../../components/Sidebar.astro';
import PostList from '../../components/PostList.astro';
import { siteConfig } from '../../config';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  
  // Get all unique tags
  const allTags = new Set<string>();
  posts.forEach(post => {
    if (post.data.tags) {
      post.data.tags.forEach(tag => allTags.add(tag));
    }
  });
  
  // Generate paths for each tag
  return Array.from(allTags).map(tag => ({
    params: { tag },
    props: { 
      tag,
      posts: posts
        .filter(post => post.data.tags && post.data.tags.includes(tag as string))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    }
  }));
}

const { tag, posts } = Astro.props;
const postCount = posts.length;
---

<BaseLayout 
  title={`Posts tagged "${tag}"`}
  description={`All blog posts tagged with "${tag}" - ${postCount} post${postCount !== 1 ? 's' : ''} found.`}
>
  <Header />
  
  <main class="main-content">
    <div class="container">
      <div class="content-grid">
        <section class="posts-section">
          <header class="tag-header">
            <h1 class="tag-title">Posts tagged "{tag}"</h1>
            <p class="tag-count">{postCount} post{postCount !== 1 ? 's' : ''} found</p>
          </header>
          
          <PostList posts={posts} currentTag={tag} />
          
          <div class="back-to-tags">
            <a href="/tags/" class="back-link">← View all tags</a>
          </div>
        </section>
        
        <Sidebar />
      </div>
    </div>
  </main>
  
  <Footer />
</BaseLayout>

<style>
  .main-content {
    padding: 2rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 3rem;
    align-items: start;
  }

  .posts-section {
    min-width: 0; /* Prevent grid overflow */
  }

  .tag-header {
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border-color);
  }

  .tag-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-heading);
  }

  .tag-count {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .back-to-tags {
    margin-top: 3rem;
    text-align: center;
  }

  .back-link {
    display: inline-block;
    color: var(--accent-color);
    text-decoration: none;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border: 1px solid var(--accent-color);
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    background: var(--accent-color);
    color: white;
  }

  @media (max-width: 768px) {
    .content-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .tag-title {
      font-size: 1.75rem;
    }

    .main-content {
      padding: 1rem 0;
    }
  }
</style>