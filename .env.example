# Groq API Key
# Get your free API key from: https://console.groq.com/keys
# Required for the recruiter chat feature
# Free tier: 14,400 requests/day, 70K tokens/min
GROQ_API_KEY=gsk_your_key_here

# Groq model ID (optional)
# Defaults to openai/gpt-oss-120b if unset.
# Set this to override without a code change when Groq deprecates a model.
# Current production models: https://console.groq.com/docs/models
# Deprecations: https://console.groq.com/docs/deprecations
GROQ_MODEL=openai/gpt-oss-120b
