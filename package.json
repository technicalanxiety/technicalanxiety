    "fast-xml-parser": "5.7.0",
    "markdownlint-cli": {
      "js-yaml": "5.4.2",
      "smol-toml": "1.9.1"
    },
    "yaml-language-server": {
      "yaml": "2.8.3"
    }
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.9.5",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.0",
    "lighthouse": "^13.4.0",
    "markdownlint-cli": "^0.49.0",
    "puppeteer": "^25.4.0",
    "sharp": "^0.35.3",
    "vitest": "^4.1.10"
  }
