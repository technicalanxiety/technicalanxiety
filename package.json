{
  "name": "astro-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cross-browser": "node scripts/cross-browser-test.js",
    "backlog": "node scripts/manage-backlog.js",
    "backlog:list": "node scripts/manage-backlog.js list",
    "backlog:check": "node scripts/manage-backlog.js check",
    "deploy:preview": "npm run build && npm run preview",
    "deploy:check": "npm run check && npm run test && npm run build",
    "verify:production": "node scripts/verify-deployment.js production",
    "verify:staging": "node scripts/verify-deployment.js staging"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.4",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "typescript": "^6.0.3"
  },
  "//overrides": "Remove yaml override when yaml-language-server ships with yaml >= 2.8.3 (GHSA-48c2-rrv3-qjmp). Remove markdownlint-cli smol-toml override when it allows smol-toml >= 1.8.1 (GHSA-r4xh-jqrq-34v2)",
